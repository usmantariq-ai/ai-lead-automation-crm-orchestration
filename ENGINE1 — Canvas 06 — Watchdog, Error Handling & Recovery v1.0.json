    {
      "parameters": {
        "jsCode": "const d=$input.first().json.decision||{};\nconst clean=(value,n=100)=>String(value??'').replace(/[\\r\\n\\t<>@&]/g,' ').replace(/\\s+/g,' ').trim().slice(0,n);\nconst detail=(d.detail && typeof d.detail==='object')?d.detail:{};\nconst sev=clean(d.severity,12).toUpperCase();\nconst event=clean(d.event_type,80);\nconst reason=clean(detail.reason||detail.error_code||detail.status||detail.source_event||detail.error_kind||'',100);\nconst lead=clean(d.lead_id||'system',40);\nconst incident=clean(d.incident_id,40);\nconst message=['ENGINE1 WATCHDOG ['+sev+']', 'Event: '+event, 'Lead: '+lead, 'Incident: '+incident];\nif(reason)message.push('Context: '+reason);\nmessage.push('Review PostgreSQL incident and source state before any replay. Unknown provider outcomes must NOT be resent blindly.');\nreturn [{json:{incident_id:d.incident_id,token:d.token,channel:d.channel,\n slack_body:{channel:d.channel,text:message.join('\\n'),unfurl_links:false,unfurl_media:false,parse:'none',link_names:false}}}];"
      },
      "id": "64c39514-d50c-4eb6-a2cb-5d3f0c0a5573",
      "name": "A5 · Compose Sanitized Slack Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        480
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://slack.com/api/chat.postMessage",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "Content-Type",
              "value": "application/json; charset=utf-8"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.slack_body }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        }
      },
      "id": "bafaa635-3ac4-4fe4-9344-652814617a0b",
      "name": "A6 · Slack / Post Operator Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        928,
        480
      ],
      "credentials": {
        "slackApi": {
          "id": "8ZiRgBNsWRuYv7v1",
          "name": "Slack account"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Assign Slack Bot HTTP Header Auth (Authorization: Bearer token) in n8n credentials. Never paste tokens into JSON."
    },
    {
      "parameters": {
        "jsCode": "const p=$('A5 · Compose Sanitized Slack Alert').first().json;\nconst r=$input.first().json||{};\nlet b=r.body||{};\nif(typeof b==='string'){try{b=JSON.parse(b)}catch{b={}}}\nconst status=Number(r.statusCode||r.response?.statusCode||0);\nconst e=String(b.error||'').toLowerCase();\nconst safe=(s)=>String(s||'').replace(/[^a-z0-9_\\-]/gi,'_').slice(0,75);\nlet result='unknown',code='slack_transport_or_ambiguous',channel=null,ts=null;\nif(status===200 && b.ok===true && b.ts && b.channel){\n result='delivered';code=null;channel=String(b.channel);ts=String(b.ts);\n}else if(status===429 || (status===200 && ['ratelimited','rate_limited'].includes(e))){\n result='retryable';code='slack_rate_limited';\n}else if(status===401||status===403||['invalid_auth','not_authed','missing_scope','token_revoked','account_inactive'].includes(e)){\n result='auth';code='slack_auth_'+safe(e||status);\n}else if(status===200 && b.ok===false){\n result='permanent';code='slack_rejected_'+safe(e||'unknown');\n}else if(status>=400&&status<500){\n result='permanent';code='slack_http_'+status;\n}else if(status>=500 || !status || (b.ok===true && (!b.ts||!b.channel))){\n result='unknown';code='slack_unknown_'+(status||'transport');\n}\nreturn [{json:{incident_id:p.incident_id,token:p.token,result,\n channel,slack_ts:ts,error_code:code,http_status:status||null}}];"
      },
      "id": "ecc40f46-f054-4d56-8336-f5cc7887aa36",
