    {
      "parameters": {
        "jsCode": "const x=$input.first().json||{};\nconst w=x.workflow||{};\nconst ex=x.execution||{};\nconst err=ex.error||x.error||{};\nconst clean=(s,n=100)=>String(s??'').replace(/[^a-z0-9._:\\-]/gi,'_').slice(0,n);\nreturn [{json:{event:{workflow_id:clean(w.id||x.workflowId||'',100),\n execution_id:clean(ex.id||x.executionId||'',100),\n last_node:clean(ex.lastNodeExecuted||x.lastNodeExecuted||'',100),\n error_kind:clean(err.name||err.type||'execution_error',60)}}}];"
      },
