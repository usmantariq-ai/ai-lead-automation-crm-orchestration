    {
      "parameters": {
        "jsCode": "const gate = $('B3 · Final Consent and Send Barrier').first().json.send_gate;\nconst response = $input.first()?.json ?? {};\nlet body = response.body;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch { body = {}; } }\nif (!body || typeof body !== 'object') body = {};\nconst status = Number(response.statusCode ?? response.status ?? 0) || 0;\nconst providerId = typeof body.id === 'string' && body.id.length > 0 ? body.id : null;\nconst rawCode = body.name ?? body.error?.name ?? body.error?.code ?? response.error?.name ?? '';\nconst errorCode = (String(rawCode || (status ? `http_${status}` : 'transport_outcome_unknown'))).slice(0,120);\nlet result = 'unknown';\nif (status >= 200 && status < 300 && providerId) result = 'accepted';\nelse if (status === 429 || status >= 500 || (status === 409 && errorCode === 'concurrent_idempotent_requests')) result = 'retryable';\nelse if (status === 401 || status === 403) result = 'auth_blocked';\nelse if (status >= 400 && status < 500) result = 'permanent';\nreturn [{json:{message_id:gate.message_id, claim_token:gate.claim_token,\n  result, http_status:status || null, provider_id:providerId, error_code:errorCode}}];"
      },
