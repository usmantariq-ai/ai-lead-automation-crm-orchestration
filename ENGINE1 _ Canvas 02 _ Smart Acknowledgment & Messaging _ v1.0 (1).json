      "parameters": {
        "jsCode": "const claim = $('P1 · Claim One Due Delivery Check').first().json.delivery_job;\nconst response = $input.first()?.json ?? {};\nlet body = response.body;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch { body = {}; } }\nif (!body || typeof body !== 'object') body = {};\nconst status = Number(response.statusCode ?? response.status ?? 0) || 0;\nconst event = typeof body.last_event === 'string' ? body.last_event.toLowerCase().slice(0,64) : null;\nreturn [{json:{message_id:claim.message_id, track_token:claim.track_token,\n  http_status:status || null, provider_event:status >= 200 && status < 300 ? event : null}}];"
